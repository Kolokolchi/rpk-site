# Local development uses the loopback origin below.
PUBLIC_ORIGIN=http://localhost:3000
# Optional comma-separated exact hosts (no schemes or paths).
ALLOWED_HOSTS=
# npm run preview supplies its guarded localhost-only production settings.
# Vercel production: PUBLIC_ORIGIN=https://www.rpk.kz
# Vercel Preview: use that deployment's exact HTTPS origin and ALLOWED_HOSTS.
